# ScanR Environment Configuration
# Copy to .env and fill in all required values before starting

# ── Security (REQUIRED) ───────────────────────────────────────────────────────

# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# Fernet key for credential vault — generate with:
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VAULT_KEY=

# ── Database (REQUIRED) ───────────────────────────────────────────────────────

# Password for the PostgreSQL scanr user
POSTGRES_PASSWORD=

# ── Admin Bootstrap (REQUIRED) ───────────────────────────────────────────────

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of origins allowed to call the API
# Default is http://localhost (suitable for local Docker deployment)
# For HTTP access over a private LAN/Tailscale IP, add that origin here and set
# SECURE_COOKIES=false in your local .env. Keep SECURE_COOKIES=true for HTTPS.
# Example: ALLOWED_ORIGINS=http://localhost,http://100.x.y.z
ALLOWED_ORIGINS=http://localhost
SECURE_COOKIES=true

# Trusted reverse-proxy peers (comma-separated IPs/CIDRs). X-Forwarded-For is
# only honoured for rate limiting when the direct peer is in this list, so
# clients can't spoof their source IP.
#
# The bundled docker-compose deployment DOES sit behind a reverse proxy: the
# frontend nginx container proxies /api and /ws to the API. So this must cover
# the Docker network, otherwise the API sees only nginx's IP and EVERY client
# shares one rate-limit bucket — meaning one client can exhaust the login limit
# for everyone. 172.16.0.0/12 covers Docker's default bridge pools.
#
# Only widen this to ranges that real clients can reach the API from directly.
# In particular, if you set SCANR_API_BIND=0.0.0.0 to expose the API on a LAN,
# narrow this to the proxy's exact address — anything in this list is trusted to
# declare its own source IP.
TRUSTED_PROXIES=172.16.0.0/12

# ── Scan Defaults ─────────────────────────────────────────────────────────────
MAX_CONCURRENT_HOSTS=50
MAX_CONCURRENT_PLUGINS=20
DEFAULT_SCAN_TIMEOUT=3600

# Hostnames/IPs that may never be a scan target (the scanner's own
# infrastructure). Merged with a built-in denylist that always rejects
# loopback, link-local (incl. 169.254.169.254 cloud metadata), multicast,
# reserved, and unspecified addresses.
SCAN_TARGET_DENYLIST=localhost,postgres,redis,db,scanr-api,scanr-worker

# Mark scans whose worker heartbeat goes stale (worker crash/OOM) as failed
# after this many seconds, instead of leaving them stuck in "running".
SCAN_HEARTBEAT_TIMEOUT=300

# ── AI features (optional) ────────────────────────────────────────────────────
# Powers AI-assisted findings summaries (and, later, report narrative,
# false-positive testing, and autonomous pentest modes). Requires the AI extra:
#   pip install -e "backend[ai]"   (or build the image with it)
# Provider ∈ anthropic | openai | deepseek. Leave AI_MODEL blank to use the
# provider's default. Set the key only for the provider(s) you use — keys are
# never logged or sent to the model as content.
AI_PROVIDER=anthropic
AI_MODEL=
AI_MAX_TOKENS=2048
# Per-minute input token rate cap for agent loop (0 = no limit).
# Anthropic free tier caps at 10,000 input tokens/min. Set to 0 if you have
# a paid plan with higher limits.
AI_RATE_LIMIT_TOKENS_PER_MIN=0
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# ── AI command-execution sandbox ──────────────────────────────────────────────
# Gives the AI agent a real shell in an isolated container.
# ON by default. REQUIRED: generate a unique token (no default is shipped —
# docker compose refuses to start while this is empty).
# Generate: openssl rand -hex 32
SANDBOX_TOKEN=
SANDBOX_IMAGE=ghcr.io/t3rr0or/scanr-sandbox:${SCANR_VERSION:-latest}
SANDBOX_CMD_TIMEOUT=120
# Concurrent headless-browser validations per worker PROCESS. A hostile page can
# pin a core for the full 60s validation cap, and Celery prefork multiplies this
# by --concurrency (4 by default), so the real ceiling is 8 browsers ≈ 8 cores.
# Turn it down on a small host.
BROWSER_VALIDATION_CONCURRENCY=2
# Ceiling on concurrent sandbox containers (each holds memory/CPU/PID budget).
SANDBOX_MAX_SESSIONS=8
# Per-run SOCKS5 egress relay. Started only when a scan opts into target egress
# (admin-only allow_target_egress); it permits that scan's authorized scope and
# refuses everything else, including loopback and cloud metadata.
SANDBOX_RELAY_IMAGE=ghcr.io/t3rr0or/scanr-sandbox-relay:${SCANR_VERSION:-latest}

# ── Application ───────────────────────────────────────────────────────────────
DEBUG=false

# Interactive API docs (/docs, /redoc, /openapi.json). Unauthenticated by nature
# — Swagger UI is a plain browser page — and they publish every route and schema,
# which is useful reconnaissance. Off for the Docker deployment; set to true if
# you want them and accept that exposure.
DOCS_ENABLED=false

# Host address the API port binds to. Default 127.0.0.1: the UI reaches the API
# through the frontend nginx proxy (/api, /ws), so direct host access to port
# 8000 stays local-only. Set to 0.0.0.0 ONLY if you need direct API access
# from other hosts (the API then bypasses the frontend nginx).
SCANR_API_BIND=127.0.0.1

# Docker image tag used by docker compose pull/up. Use "latest" for simple
# updates, or pin a version such as "0.9.1" for controlled deployments.
SCANR_VERSION=latest

# ── Optional In-App Updates ──────────────────────────────────────────────────
# Set SELF_UPDATE_ENABLED=true and uncomment COMPOSE_FILE below to unlock the
# "Update Now" button in Settings > System. Requires Docker socket access on
# the host. The self-update overlay mounts the socket and project directory
# into the API container — only for trusted admin deployments.
SELF_UPDATE_ENABLED=false
# COMPOSE_FILE=docker-compose.yml:docker-compose.self-update.yml
